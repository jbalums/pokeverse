{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "verdant-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');const root=p.resolve('prototypes');h.createServer((q,s)=>{const u=decodeURIComponent(q.url.split('?')[0]);const file=p.resolve(root,'.'+(u==='/'?'/verdant-town-3d.html':u));if(!file.startsWith(root))return s.writeHead(403).end();f.readFile(file,(e,d)=>{if(e)return s.writeHead(404).end();s.writeHead(200,{'Content-Type':file.endsWith('.js')?'text/javascript':'text/html'});s.end(d)})}).listen(8765,'127.0.0.1')"],
      "port": 8765
    }
  ]
}
